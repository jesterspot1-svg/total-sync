{
  "name": "total-sync",
  "version": "0.2.0",
  "private": true,
  "description": "Obsidian vault sync using Mail Cloud WebDAV",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "security": "node scripts/check-release.mjs",
    "smoke": "node scripts/smoke-plugin.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run smoke && npm run security"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.5.1",
    "obsidian": "1.14.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "eslint-plugin-n": {
      "minimatch": "11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
